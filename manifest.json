{
  "manifest_version": 3,
  "name": "Hello Extension",
  "version": "1.0",

  "icons": {
    "128": "images/icon.png"
  },

  "action": {
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}